# ==============================================================================
# AWS Dynamic Inventory Template (inventory_aws.ini.example)
# Real inventory file (inventory_aws.ini) is git-ignored for security.
# ==============================================================================

[prod_servers]
# Set the PROD_SERVER_IP environment variable or replace with your EC2 Private/Public IP
prod_vm ansible_host=YOUR_AWS_PROD_IP ansible_user=ubuntu ansible_ssh_private_key_file=/var/lib/jenkins/.ssh/id_rsa ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[prod_servers:vars]
app_name=road-helper
app_port=8080
db_port=5432
app_dir=/opt/road-helper
backup_dir=/opt/road-helper/backups
app_version=1.0.0-aws
