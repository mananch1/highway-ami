# ==============================================================================
# AWS Cloud Deployment Environment Configuration (.env.example)
# Copy this file to .env locally or on the Jenkins VM at /var/lib/jenkins/.env
# DO NOT commit real IP addresses or secrets to Git!
# ==============================================================================

# AWS Region (Mumbai)
AWS_REGION=ap-south-1

# Target Production Host IP (Use AWS Private IP if in same VPC, or Elastic IP)
PROD_SERVER_IP=

# SSH Configuration for Ansible Remote Execution
SSH_USER=ubuntu
SSH_KEY_PATH=/var/lib/jenkins/.ssh/id_rsa

# Application Ports
APP_PORT=80
DB_PORT=5432
APP_NAME=road-helper
